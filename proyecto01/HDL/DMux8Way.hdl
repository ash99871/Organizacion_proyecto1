// Codigo para el chip DMux8Way

CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux4Way(in=in , sel=sel[1..2] , a=inWay0 , b=inWay1 , c=inWay2 , d=inWay3 );
    DMux(in=inWay0 , sel=sel[0] , a=a , b=b );
    DMux(in=inWay1 , sel=sel[0] , a=c , b=d );
    DMux(in=inWay2 , sel=sel[0] , a=e , b=f );
    DMux(in=inWay3 , sel=sel[0] , a=g , b=h );
}